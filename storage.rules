rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imagens dos produtos: leitura pública para a loja.
    // Upload, alteração e exclusão somente para usuários autenticados.
    match /japanexpress/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de avaliações: leitura pública e upload limitado a imagens.
    match /review-photos/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /japanexpress/__test__/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Vídeos de avaliações: leitura pública e upload limitado a vídeos.
    match /review-videos/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 60 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Bloqueia qualquer caminho não declarado acima.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
