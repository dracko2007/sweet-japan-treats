rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true;
    }

    function activeAdmin() {
      return signedIn()
        && (
          firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('active', false) == true
          || request.auth.token.get('email', '').matches('.*@japanexpress-store[.]com')
        );
    }
    // Imagens dos produtos: leitura pública para a loja.
    // Catalog media is administrator-owned; anonymous checkout identities
    // must never be able to replace it.
    match /japanexpress/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if (signedIn() || activeAdmin())
                   && request.resource != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Product videos use a separate namespace so image MIME rules cannot
    // accidentally reject (or permit) video uploads.
    match /japanexpress/product-videos/{productId}/{fileName} {
      allow read: if true;
      allow write: if activeAdmin()
                   && request.resource != null
                   && request.resource.size < 60 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    // Fotos de avaliações: leitura pública e upload limitado a imagens.
    match /review-photos/{productId}/{fileName} {
      allow read: if true;
      allow write: if verifiedUser()
                   && request.resource != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /japanexpress/__test__/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Vídeos de avaliações: leitura pública e upload limitado a vídeos.
    match /review-videos/{productId}/{fileName} {
      allow write: if verifiedUser()
                   && request.resource != null
                   && request.resource.size < 60 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Bloqueia qualquer caminho não declarado acima.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
